{
  "name": "driftor-asc-ipdd",
  "version": "1.0.0",
  "private": true,
  "description": "Microsserviço 2 do Driftor ASC: CRUD de análises IPDD/ADWIN no Azure SQL, com eventos no Azure Service Bus.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/main.js",
    "dev": "ts-node src/api/main.ts",
    "test": "jest && npm run test:arch",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "lint:types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/service-bus": "7.10.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "mssql": "11.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/jest": "29.5.14",
    "@types/mssql": "9.1.7",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.3",
    "dependency-cruiser": "16.10.4",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  }
}
